{
  "name": "azper",
  "version": "0.1.0",
  "private": true,
  "description": "A terminal-native coding-agent harness built on Pi",
  "type": "module",
  "bin": {
    "azper": "dist/cli.js"
  },
  "files": ["dist", "README.md"],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/cli.js",
    "lint": "oxlint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.84.4",
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@earendil-works/pi-tui": "^0.84.4",
    "chalk": "^5.6.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "oxlint": "^1.79.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "vitest": "^4.1.11"
  }
}
